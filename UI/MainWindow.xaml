<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Title="BMBank Admin UI"
        Height="450"
        Width="800">

    <DockPanel>
        
        <Border DockPanel.Dock="Top" Background="#1E293B" Padding="12">
            <TextBlock Text="BMBank – Admin UI"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="SemiBold" />
        </Border>
        
        <Border DockPanel.Dock="Bottom" Background="#F1F5F9" Padding="8">
            <StackPanel>
                <TextBlock Text="{Binding ServerStatus}"
                           Foreground="{Binding ServerStatusColor}"
                           FontWeight="Bold" />

                <TextBlock Text="{Binding ConnectedClientsText}" />
            </StackPanel>
        </Border>
        
        <TabControl>
            
            <TabItem Header="Clients">
                <Grid Margin="10">
                    <DataGrid ItemsSource="{Binding Clients}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP Address"
                                                Binding="{Binding Ip}"
                                                Width="*" />
                            <DataGridTextColumn Header="Last Command"
                                                Binding="{Binding LastCommand}"
                                                Width="2*" />
                            <DataGridTextColumn Header="Timestamp"
                                                Binding="{Binding Timestamp}"
                                                Width="*" />
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            
            <TabItem Header="Accounts">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <GroupBox Header="Active Accounts" Margin="0,0,0,10">
                        <DataGrid ItemsSource="{Binding ActiveAccounts}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account"
                                                    Binding="{Binding AccountNumber}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Balance"
                                                    Binding="{Binding Balance}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Created At"
                                                    Binding="{Binding CreatedAt}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                    
                    <GroupBox Header="Closed Accounts" Grid.Row="1">
                        <DataGrid ItemsSource="{Binding ClosedAccounts}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Account"
                                                    Binding="{Binding AccountNumber}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Balance"
                                                    Binding="{Binding Balance}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Created At"
                                                    Binding="{Binding CreatedAt}"
                                                    Width="*" />
                                <DataGridTextColumn Header="Closed At"
                                                    Binding="{Binding ClosedAt}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>

